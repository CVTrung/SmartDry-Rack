# Firebase Admin SDK
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=secrets/service-account.json

# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_LAT=10.8231
OPENWEATHER_LON=106.6297

# Device and location
DEVICE_ID=device_001
LOCATION_ID=location_hcm

# Weather scheduling
CURRENT_WEATHER_CHECK_INTERVAL_MINUTES=5
FORECAST_CHECK_INTERVAL_MINUTES=30
FORECAST_HORIZON_HOURS=24

# Rain alert rules
RAIN_ALERT_THRESHOLD_PERCENT=70
RAIN_WARNING_WINDOW_MINUTES=180
RAIN_ALERT_COOLDOWN_MINUTES=60

# Gmail notifications
EMAIL_NOTIFICATIONS_ENABLED=true
GMAIL_SENDER_EMAIL=sender@example.com
# Optional fallback; account-specific authorized Gmail is preferred.
GMAIL_RECIPIENT_EMAIL=
GMAIL_CREDENTIALS_PATH=secrets/gmail-credentials.json
GMAIL_TOKEN_PATH=secrets/gmail-token.json
GMAIL_MAX_RETRY_ATTEMPTS=3
